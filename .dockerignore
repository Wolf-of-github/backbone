# Root build context exclusions.
# depends_on: []
#
# Most service Dockerfiles build from the REPO ROOT (they COPY services/common),
# so this file - not the per-service ones - governs what Docker receives.
#
# Two reasons it matters:
#  1. Secrets. .env holds every password in the platform. Without this line it
#     is sent into the build context on every build, and anything COPYing a
#     broad path could bake it into a layer.
#  2. Size. node_modules across the services is ~56MB of host-built artifacts
#     that must never reach an image - the Dockerfiles run npm ci themselves,
#     and Linux images must not inherit macOS-built native modules.

# Secrets and local state
.env
.env.*
!.env.example
kubeconfig
*.kubeconfig
.secrets/
*.pem
*.key
*.crt

# Rendered manifests (regenerated by the bootstrap scripts every run)
.rendered/

# Host-built dependencies - images install their own
node_modules/
**/node_modules/

# VCS and tooling
.git/
.gitignore
.github/

# Docs and non-build assets
*.md
docs/
architecture.txt

# Kubernetes manifests and scripts are applied by kubectl, never built into images
k8s/
ci/

# OS cruft
.DS_Store
*.log
*.tmp
