# backbone / Phase 0 - host-level configuration template.
# depends_on: []
#
# Usage:  cp .env.example .env  &&  edit .env  (never commit .env)
# Every script sources .env from the repo root.
#
# TWO MODES:
#   MULTI_NODE=false  ->  k3d (k3s-in-Docker) on THIS machine only. Zero setup
#                         beyond a running Docker daemon. Great for dev/demo.
#   MULTI_NODE=true   ->  a real k3s SERVER on this machine that other machines
#                         (EC2, spare boxes, other clouds) join as workers with
#                         `scripts/node-join.sh`. This is the horizontal-scale path.

# --- Mode -----------------------------------------------------------------
MULTI_NODE=false

# --- Domain --------------------------------------------------------------------
# Public base domain for the platform (used later for TLS SANs, Kong routes).
# For local-only use, leave as-is; nothing in Phase 0 needs real DNS.
DOMAIN=backbone.local

# --- Cluster identity ----------------------------------------------------------
CLUSTER_NAME=backbone
# k3s version. For MULTI_NODE=false this is a rancher/k3s image tag (…-k3s1);
# for MULTI_NODE=true it is an INSTALL_K3S_VERSION channel/tag (…+k3s1).
# Keep them in sync; the scripts translate the separator.
K3S_VERSION=v1.30.4-k3s1

# ============================================================================
# MULTI_NODE=false  (k3d)  -- only these matter
# ============================================================================
# Extra worker nodes as Docker containers on THIS host. 0 = single node.
K3D_AGENTS=0
# Host ports the k3d load balancer publishes (Kong sits behind these later).
HTTP_PORT=8080
HTTPS_PORT=8443
# k3d's built-in registry: container name + HOST port + fixed IN-CLUSTER port.
# Push from your machine to localhost:<REGISTRY_PORT>; reference images in k8s
# as <REGISTRY_NAME>:<REGISTRY_INTERNAL_PORT>. macOS holds :5000, hence 5001.
REGISTRY_NAME=backbone-registry
REGISTRY_PORT=5001
REGISTRY_INTERNAL_PORT=5000

# ============================================================================
# MULTI_NODE=true  (real k3s server + joinable workers)
# ============================================================================
# The address every worker node will dial to reach this server's API (:6443).
# MUST be reachable from every machine you intend to join:
#   - all nodes in one VPC  -> the server's private IP
#   - nodes across networks -> a public IP / DNS name (and see WireGuard below)
K3S_SERVER_ADDR=

# Advertise this address to peers as the node's routable IP. Set to the same
# public IP as K3S_SERVER_ADDR when nodes are on different networks; leave blank
# inside a single flat/VPC network.
NODE_EXTERNAL_IP=

# Encrypt all node-to-node (pod overlay) traffic with WireGuard. Strongly
# recommended whenever nodes are not all on one trusted private network.
# true  -> k3s installed with --flannel-backend=wireguard-native
# false -> plain VXLAN (only safe inside one private network)
WIREGUARD=true

# Human label applied to THIS server node (kubectl get nodes -L backbone.dev/role).
NODE_ROLE=control-plane

# Join token. Leave BLANK - `make cluster` generates one on the server and
# `scripts/node-join.sh` reads it. Never commit a real token.
K3S_TOKEN=

# ---------------------------------------------------------------------------
# FIREWALL: for MULTI_NODE=true, open these BETWEEN nodes (e.g. one AWS
# security group referencing itself):
#     6443/tcp   Kubernetes API      (workers -> server)
#     10250/tcp  kubelet             (all nodes <-> all nodes)
#     51820/udp  flannel WireGuard   (all nodes <-> all nodes)   [WIREGUARD=true]
#     8472/udp   flannel VXLAN       (all nodes <-> all nodes)   [WIREGUARD=false]
# Nothing else needs to be open between nodes. Public traffic reaches the
# platform only through Kong (Phase 2), not these ports.
# ---------------------------------------------------------------------------
