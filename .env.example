# backbone / Phase 0 - host-level configuration template.
# depends_on: []
#
# Usage:  cp .env.example .env  &&  edit .env  (never commit .env)
# Every script sources .env from the repo root.
#
# Phase 0 runs entirely in Docker via k3d (k3s-in-Docker). No Linux host,
# no Docker Desktop requirement beyond a working Docker daemon.

# --- Domain ------------------------------------------------------------------
# Public base domain for the platform (used later for TLS SANs, Kong routes).
# For local-only use, leave as-is; nothing in Phase 0 needs real DNS.
DOMAIN=backbone.local

# --- k3d cluster -----------------------------------------------------------
CLUSTER_NAME=backbone
# k3s image tag for the k3d nodes. https://hub.docker.com/r/rancher/k3s/tags
K3S_VERSION=v1.30.4-k3s1
# Extra worker nodes (Docker containers). 0 = single-node.
K3D_AGENTS=0
# Host ports the k3d load balancer publishes (Kong will sit behind these later).
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Built-in container registry (managed by k3d) --------------------------
# k3d creates a registry container named "<REGISTRY_NAME>" on this HOST port.
# Reachable as localhost:<REGISTRY_PORT> from your machine AND as
# <REGISTRY_NAME>:<REGISTRY_INTERNAL_PORT> from inside the cluster.
# NOTE: on macOS, port 5000 is taken by AirPlay/Control Center - hence 5001.
#       Pick any free host port if 5001 collides on your machine.
REGISTRY_NAME=backbone-registry
REGISTRY_PORT=5001
# Fixed: the port the registry listens on *inside* the k3d network. Leave at 5000.
REGISTRY_INTERNAL_PORT=5000
