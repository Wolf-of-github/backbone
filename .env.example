# backbone / Phase 0 - host-level configuration template.
# depends_on: []
#
# Usage:  cp .env.example .env  &&  edit .env  (never commit .env)
# Every script sources .env from the repo root.
#
# backbone runs on Linux. `make cluster` installs a k3s SERVER (control plane)
# on THIS host; other Linux machines join as workers with scripts/node-join.sh.
# Any laptop can then drive the cluster by pointing kubectl at ./kubeconfig -
# nothing is installed on the laptop.

# --- Cluster identity --------------------------------------------------------
CLUSTER_NAME=backbone
# k3s version. Accepts the image-style tag (v1.30.4-k3s1) or the installer
# channel (v1.30.4+k3s1); the scripts normalise it. See:
#   https://github.com/k3s-io/k3s/releases
K3S_VERSION=v1.30.4+k3s1

# --- Domain ----------------------------------------------------------------
# Public base domain for the platform (TLS SANs, Kong routes - later phases).
DOMAIN=backbone.local

# --- Control plane -------------------------------------------------------------
# Address every worker will dial to reach this server's API (:6443). MUST be
# reachable from each machine you intend to join:
#   - all nodes in one VPC  -> the server's private IP
#   - nodes across networks -> a public IP / DNS name, OR a Tailscale IP (TAILSCALE=true)
K3S_SERVER_ADDR=

# Advertise this address to peers as this node's routable IP. Set when nodes span
# networks; leave blank inside one flat/VPC network. With TAILSCALE=true it is
# auto-filled from `tailscale ip -4` on each node, so leave it blank.
NODE_EXTERNAL_IP=

# TAILSCALE=true: nodes are joined over a Tailscale tunnel (works behind NAT / no
# public IP). Each node auto-advertises its own 100.x tailnet IP; set
# K3S_SERVER_ADDR to the SERVER's tailnet IP. Requires `tailscale` installed and
# `sudo tailscale up` run on every node. Then set WIREGUARD=false below
# (Tailscale already encrypts - no need for flannel WireGuard on top).
TAILSCALE=false

# Encrypt all node-to-node (pod overlay) traffic with WireGuard. Keep true unless
# every node is on one trusted private network OR TAILSCALE=true.
#   true  -> k3s installed with --flannel-backend=wireguard-native
#   false -> plain VXLAN
WIREGUARD=true

# Human label applied to THIS server node (kubectl get nodes -L backbone.dev/role).
NODE_ROLE=control-plane

# Join token. Leave BLANK - `make cluster` generates one on the server and caches
# it to .secrets/cluster-join.env (gitignored); scripts/node-join.sh reads it.
K3S_TOKEN=

# ---------------------------------------------------------------------------
# FIREWALL: open these BETWEEN nodes (e.g. one AWS security group referencing
# itself). Nothing else needs to be open between nodes; public traffic reaches
# the platform only through Kong (Phase 2).
#     6443/tcp   Kubernetes API      (workers -> server)
#     10250/tcp  kubelet             (all nodes <-> all nodes)
#     51820/udp  flannel WireGuard   (all nodes <-> all nodes)   [WIREGUARD=true]
#     8472/udp   flannel VXLAN       (all nodes <-> all nodes)   [WIREGUARD=false]
# ---------------------------------------------------------------------------

# ===========================================================================
# Phase 1 - Data layer  (consumed by scripts/data-secrets.sh -> K8s Secrets
# mongodb-credentials + redis-password in the `data` namespace).
#
# Generate each password with:  openssl rand -base64 24
# data-secrets.sh does NOT auto-generate: it fails if any value below is blank.
# Record these somewhere safe - losing them means losing access to the data.
# Rotating: change here, `make secrets-data`, then rollout-restart the StatefulSet.
# ===========================================================================

# MongoDB root (cluster admin). Used by the image to bootstrap the datadir and
# by the init Job; application services never get these.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

# MongoDB least-privilege application user (readWrite on MONGO_APP_DB only).
# This is what auth (Phase 3), jobs-api and the worker (Phase 4) connect with.
MONGO_APP_USER=backbone_app
MONGO_APP_PASSWORD=
MONGO_APP_DB=backbone

# Redis password (requirepass + every client's AUTH).
REDIS_PASSWORD=

# ===========================================================================
# Phase 2 - Edge  (Kong API gateway + ping service + frontend)
#
# Images are built and pushed to REGISTRY_URL (Docker Hub or GitHub Container
# Registry) until Phase 5 brings up the in-cluster registry.
# ===========================================================================

# Docker registry URL for pushing built images. Must be set before `make phase2`.
# Examples:
#   docker.io/youruser         (Docker Hub)
#   ghcr.io/youruser           (GitHub Container Registry)
# If using a private registry, create a docker-registry secret manually:
#   kubectl -n app create secret docker-registry registry-credentials \
#     --docker-server=<registry> --docker-username=<user> --docker-password=<token>
# Phase 5 automates this with the in-cluster registry.
REGISTRY_URL=

# Kong proxy public port (HTTP). HTTPS on 443 added in Phase 5 (TLS).
KONG_PROXY_PORT=80

# Kong Admin API port (internal ClusterIP only, never exposed publicly).
KONG_ADMIN_PORT=8001
