# backbone / Phase 0 - host-level configuration template.
# depends_on: []
#
# Usage:  cp .env.example .env  &&  edit .env  (never commit .env)
# Every script sources .env from the repo root.

# --- Domain -----------------------------------------------------------------
# Public base domain for the platform (used later for TLS SANs, Kong routes).
DOMAIN=backbone.example.com

# --- Private container registry ------------------------------------------------
# Host/IP the nodes and CI use to reach the in-cluster registry.
# Must resolve from every k3s node. Use the server IP if you have no DNS.
REGISTRY_HOST=10.0.0.10
REGISTRY_PORT=5000
REGISTRY_USER=backbone
# Choose a long random value. Filled into an htpasswd file, never stored in git.
REGISTRY_PASS=change-me-to-a-long-random-string

# --- k3s --------------------------------------------------------------------
# Pin the k3s version so installs are reproducible. See https://github.com/k3s-io/k3s/releases
K3S_VERSION=v1.30.4+k3s1
# IP the API server advertises / that ./kubeconfig will point at.
K3S_SERVER_IP=10.0.0.10
# Comma-separated agent node IPs to join. Leave blank for a single-node cluster.
K3S_NODE_IPS=
# Node join token. Leave blank; install-k3s.sh reads it from the server after install
# and prints the agent join command. Do not commit a real token.
K3S_TOKEN=
