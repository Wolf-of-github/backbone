# backbone / Phase 0 - host-level configuration template.
# depends_on: []
#
# Usage:  cp .env.example .env  &&  edit .env  (never commit .env)
# Every script sources .env from the repo root.
#
# backbone runs on Linux. `make cluster` installs a k3s SERVER (control plane)
# on THIS host; other Linux machines join as workers with scripts/node-join.sh.
# Any laptop can then drive the cluster by pointing kubectl at ./kubeconfig -
# nothing is installed on the laptop.

# --- Cluster identity --------------------------------------------------------
CLUSTER_NAME=backbone
# k3s version. Accepts the image-style tag (v1.30.4-k3s1) or the installer
# channel (v1.30.4+k3s1); the scripts normalise it. See:
#   https://github.com/k3s-io/k3s/releases
K3S_VERSION=v1.30.4+k3s1

# --- Domain ----------------------------------------------------------------
# Public base domain for the platform (TLS SANs, Kong routes).
#
# OPTIONAL. The default `backbone.local` means "no real domain" - the whole
# platform, TLS included, comes up and passes every gate without one. Phase 5
# serves HTTPS with a self-signed cert on the node IP (TLS_MODE=selfsigned).
#
# To adopt a real domain later: point its A record at this node, set DOMAIN
# below, then set TLS_MODE=staging (rehearse) and TLS_MODE=production in the
# Phase 5 block and re-run `make tls`. Nothing else changes - no rebuild, no
# manifest edit. Keep TLS_MODE=selfsigned until DOMAIN actually resolves.
DOMAIN=backbone.local

# --- Control plane -------------------------------------------------------------
# Address every worker will dial to reach this server's API (:6443). MUST be
# reachable from each machine you intend to join:
#   - all nodes in one VPC  -> the server's private IP
#   - nodes across networks -> a public IP / DNS name, OR a Tailscale IP (TAILSCALE=true)
K3S_SERVER_ADDR=

# Advertise this address to peers as this node's routable IP. Set when nodes span
# networks; leave blank inside one flat/VPC network. With TAILSCALE=true it is
# auto-filled from `tailscale ip -4` on each node, so leave it blank.
NODE_EXTERNAL_IP=

# TAILSCALE=true: nodes are joined over a Tailscale tunnel (works behind NAT / no
# public IP). Each node auto-advertises its own 100.x tailnet IP; set
# K3S_SERVER_ADDR to the SERVER's tailnet IP. Requires `tailscale` installed and
# `sudo tailscale up` run on every node. Then set WIREGUARD=false below
# (Tailscale already encrypts - no need for flannel WireGuard on top).
TAILSCALE=false

# Encrypt all node-to-node (pod overlay) traffic with WireGuard. Keep true unless
# every node is on one trusted private network OR TAILSCALE=true.
#   true  -> k3s installed with --flannel-backend=wireguard-native
#   false -> plain VXLAN
WIREGUARD=true

# Human label applied to THIS server node (kubectl get nodes -L backbone.dev/role).
NODE_ROLE=control-plane

# Join token. Leave BLANK - `make cluster` generates one on the server and caches
# it to .secrets/cluster-join.env (gitignored); scripts/node-join.sh reads it.
K3S_TOKEN=

# SSH private key node-join.sh uses to reach a worker in REMOTE mode
# (./scripts/node-join.sh user@worker-ip, run from the server). Blank uses
# your default SSH agent/config. Set this when the worker's key pair isn't
# already loaded there - e.g. a .pem you copied onto this server yourself.
SSH_KEY=

# ---------------------------------------------------------------------------
# FIREWALL: open these BETWEEN nodes (e.g. one AWS security group referencing
# itself). Nothing else needs to be open between nodes; public traffic reaches
# the platform only through Kong (Phase 2).
#     6443/tcp   Kubernetes API      (workers -> server)
#     10250/tcp  kubelet             (all nodes <-> all nodes)
#     51820/udp  flannel WireGuard   (all nodes <-> all nodes)   [WIREGUARD=true]
#     8472/udp   flannel VXLAN       (all nodes <-> all nodes)   [WIREGUARD=false]
# ---------------------------------------------------------------------------

# ===========================================================================
# Phase 1 - Data layer  (consumed by scripts/data-secrets.sh -> K8s Secrets
# mongodb-credentials + redis-password in the `data` namespace).
#
# Generate each password with:  openssl rand -base64 24
# data-secrets.sh does NOT auto-generate: it fails if any value below is blank.
# Record these somewhere safe - losing them means losing access to the data.
# Rotating: change here, `make secrets-data`, then rollout-restart the StatefulSet.
# ===========================================================================

# MongoDB root (cluster admin). Used by the image to bootstrap the datadir and
# by the init Job; application services never get these.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

# MongoDB least-privilege application user (readWrite on MONGO_APP_DB only).
# This is what auth (Phase 3), jobs-api and the worker (Phase 4) connect with.
MONGO_APP_USER=backbone_app
MONGO_APP_PASSWORD=
MONGO_APP_DB=backbone

# Redis password (requirepass + every client's AUTH).
REDIS_PASSWORD=

# ===========================================================================
# Phase 2 - Edge  (Kong API gateway + ping service + frontend)
#
# Images are built and pushed to REGISTRY_URL (Docker Hub or GitHub Container
# Registry) until Phase 5 brings up the in-cluster registry.
# ===========================================================================

# Docker registry URL for pushing built images. Must be set before `make phase2`.
# Examples:
#   docker.io/youruser         (Docker Hub)
#   ghcr.io/youruser           (GitHub Container Registry)
# If using a private registry, create a docker-registry secret manually:
#   kubectl -n app create secret docker-registry registry-credentials \
#     --docker-server=<registry> --docker-username=<user> --docker-password=<token>
# Phase 5 automates this with the in-cluster registry.
REGISTRY_URL=

# Kong proxy public port (HTTP). HTTPS on 443 added in Phase 5 (TLS).
KONG_PROXY_PORT=80

# Kong Admin API port (internal ClusterIP only, never exposed publicly).
KONG_ADMIN_PORT=8001

# ===========================================================================
# Phase 3 - Auth  (JWT-based authentication via Express + Passport.js)
#
# JWT keys are auto-generated by scripts/jwt-keys.sh and stored in k8s secrets
# (never in .env). These settings control token expiry and CORS.
# ===========================================================================

# JWT access token expiry (short-lived, verified by Kong on every request).
# Examples: 15m, 1h, 2h
JWT_ACCESS_EXPIRY=15m

# JWT refresh token expiry (stored in Redis, single-use rotation).
# Examples: 7d, 14d, 30d
JWT_REFRESH_EXPIRY=7d

# Frontend URL for CORS (allow credentials from this origin).
# Fill this after Phase 2 is deployed with the Kong proxy public endpoint.
# Example: http://100.64.195.64:30080
FRONTEND_URL=

# ===========================================================================
# Phase 5 - Operate  (5A TLS -> 5B Observability)
#
# Every default below is chosen so `make phase5` works on a cluster with NO
# domain and no external accounts. Fill only what a track needs.
#
# 5C (CI/CD + in-cluster registry) is not on this branch - deferred by
# choice; see HANDOFF.md and the phase-5c-cicd branch.
# ===========================================================================

# --- 5A TLS (cert-manager + Kong HTTPS listener) ---------------------------
# selfsigned  (default) cert-manager mints a self-signed cert for the node IP.
#                       HTTPS works immediately; browsers warn. No DNS needed.
# staging               Let's Encrypt STAGING. Rehearsal - untrusted chain, no
#                       rate limits. Requires a real DOMAIN + ACME_EMAIL.
# production            Let's Encrypt PRODUCTION. Requires a real DOMAIN +
#                       ACME_EMAIL, and DOMAIN must already resolve here.
# The cert always lands in the same Secret (kong-tls-cert), so switching modes
# reissues the certificate without touching any other wiring.
TLS_MODE=selfsigned

# Contact address Let's Encrypt uses for expiry warnings.
# Required ONLY when TLS_MODE=staging or production. Ignored for selfsigned.
ACME_EMAIL=

# NodePort for HTTPS. HTTP stays on 30080 and 301-redirects here.
KONG_HTTPS_NODEPORT=30443

# --- 5B Observability (Prometheus + Loki + Grafana) ------------------------
GRAFANA_ADMIN_USER=admin
# Required before `make obs`.  generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# How long metrics and logs are kept. Sized for local-path disks - raise only
# if the PVCs in k8s/observability/ are raised to match.
PROM_RETENTION=15d
LOKI_RETENTION=168h

# Optional webhook for alerts and CI notifications (Slack/Discord/generic).
# Blank = alerts still collect in Alertmanager, they just aren't pushed out.
ALERT_WEBHOOK_URL=

# ===========================================================================
# Phase 6A - Backup / Disaster Recovery
#
# Nightly mongodump + Redis RDB snapshots, uploaded to EXTERNAL S3-compatible
# object storage. External is the point: a backup on the same disk as the
# database survives a dropped collection, but not the disk dying - which is
# the failure that actually ends the platform.
#
# BEFORE `make backup`, create the bucket yourself and do two things:
#   1. Turn ON object versioning (+ a lifecycle rule to expire old versions).
#      Without it, anything that can write to the bucket can also destroy
#      history by overwriting. This is what makes the backups ransomware-
#      resistant rather than merely present.
#   2. Issue an access key scoped to THIS BUCKET ONLY, with s3:PutObject,
#      GetObject, ListBucket and DeleteObject. Never a root/admin key - it
#      lives in the cluster and is only as safe as the cluster.
# ===========================================================================

# S3 endpoint. Blank = AWS S3. Set for other providers, e.g.
#   https://s3.us-west-001.backblazeb2.com     (Backblaze B2)
#   https://<accountid>.r2.cloudflarestorage.com  (Cloudflare R2)
BACKUP_S3_ENDPOINT=

# Bucket that receives the backups. Required - the job does NOT create it.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1

# Credentials for the scoped key described above. Required.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Key prefix inside the bucket (lets one bucket serve several clusters).
BACKUP_S3_PREFIX=backbone

# Cron schedules, UTC. Redis runs an hour after Mongo so the two never
# contend for the staging volume.
BACKUP_SCHEDULE_MONGO="0 3 * * *"
BACKUP_SCHEDULE_REDIS="0 4 * * *"

# Objects older than this are pruned after each successful upload.
# NOTE the resulting RPO: with nightly dumps you can lose up to 24h of data.
BACKUP_RETENTION_DAYS=30

# Local staging volume. Dumps land here, upload, are verified remotely, then
# deleted. Size it >= 2x your expected dump so a run never half-fills it.
BACKUP_STAGING_SIZE=5Gi

# ===========================================================================
# Phase 6B - Maintenance mode
#
# The HTTP off-switch (/internal/maintenance) needs an admin user to call it.
# `make backbone` / `make phase6b` promotes this address to admin once the
# auth service is up and this account has registered. Optional: leave blank
# to skip auto-promotion and do it yourself later (see the install guide).
# ===========================================================================
ADMIN_EMAIL=
