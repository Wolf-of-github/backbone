# Reference shape of the real ./kubeconfig produced by scripts/install-k3s.sh.
# depends_on: [scripts/install-k3s.sh]
#
# The real file is written to the repo root as ./kubeconfig and is gitignored.
# install-k3s.sh copies /etc/rancher/k3s/k3s.yaml here and rewrites `server:`
# from https://127.0.0.1:6443 to https://<K3S_SERVER_IP>:6443.
apiVersion: v1
kind: Config
clusters:
  - name: default
    cluster:
      server: https://10.0.0.10:6443
      certificate-authority-data: <base64 CA cert>
contexts:
  - name: default
    context:
      cluster: default
      user: default
current-context: default
users:
  - name: default
    user:
      client-certificate-data: <base64 client cert>
      client-key-data: <base64 client key>
