# Template for /etc/rancher/k3s/registries.yaml on every k3s node.
# depends_on: [scripts/bootstrap-registry.sh]
#
# scripts/bootstrap-registry.sh renders this from .env into ./config/registries.yaml
# (gitignored - it contains credentials), installs it to /etc/rancher/k3s/registries.yaml
# on each node (mode 0600), and restarts k3s so containerd picks it up.
mirrors:
  "<REGISTRY_HOST>:<REGISTRY_PORT>":
    endpoint:
      - "https://<REGISTRY_HOST>:<REGISTRY_PORT>"
configs:
  "<REGISTRY_HOST>:<REGISTRY_PORT>":
    auth:
      username: "<REGISTRY_USER>"
      password: "<REGISTRY_PASS>"
    tls:
      # CA that signed the registry cert (scripts/registry-secret.sh writes it here).
      ca_file: "/etc/rancher/k3s/registry-ca.crt"
