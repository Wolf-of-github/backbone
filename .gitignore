# backbone / Phase 0 - local state, secrets, generated artifacts. Never commit these.
# depends_on: []

# Host-level config (copied from .env.example, filled with real values)
/.env

# Kubeconfigs - the real one is generated by scripts/install-k3s.sh
/kubeconfig
*.kubeconfig
/config/kubeconfig
!/config/kubeconfig.example

# Registry auth / TLS material generated by scripts/registry-secret.sh
/.secrets/
htpasswd
*.htpasswd
*.pem
*.key
*.crt
*.csr

# Rendered node config (contains registry credentials)
/config/registries.yaml
!/config/registries.yaml.example

# Build / scratch output
/build/
/dist/
*.tmp
*.log

# OS cruft
.DS_Store
