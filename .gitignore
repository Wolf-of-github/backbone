# backbone / Phase 0 - local state, secrets, generated artifacts. Never commit these.
# depends_on: []

# Host-level config (copied from .env.example, filled with real values)
/.env

# Repo-local kubeconfig, written by scripts/cluster-up.sh
/kubeconfig
*.kubeconfig

# Secret material: the k3s cluster-join token, later-phase certs, etc.
/.secrets/
*.pem
*.key
*.crt
*.csr
htpasswd
*.htpasswd

# Node dependencies (every service under /services)
node_modules/

# Build / scratch output
/build/
/dist/
*.tmp
*.log

# Phase 5: manifests rendered from templates by bootstrap scripts (DOMAIN/TLS_MODE
# substituted in). Generated on every run - the templates are the source of truth.
/.rendered/

# 'make backbone' progress stamps - lets a re-run resume after a mid-way
# failure instead of redoing already-completed phases. 'make backbone-reset'
# clears these to force a full re-run.
/.backbone-state/

# OS cruft
.DS_Store

# Context handoff scratch file (not project docs)
/docs/handoff.md
