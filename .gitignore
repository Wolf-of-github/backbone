# backbone / Phase 0 - local state, secrets, generated artifacts. Never commit these.
# depends_on: []

# Host-level config (copied from .env.example, filled with real values)
/.env

# Repo-local kubeconfig, written by scripts/cluster-up.sh
/kubeconfig
*.kubeconfig

# Rendered k3d config (may contain env-specific values)
/config/.k3d-cluster.rendered.yaml

# Secret material: cluster join token (multi-node), later-phase certs, etc.
/.secrets/
*.pem
*.key
*.crt
*.csr
htpasswd
*.htpasswd

# Build / scratch output
/build/
/dist/
*.tmp
*.log

# OS cruft
.DS_Store
